# Copy to service/.env. Docker Compose reads it if the file exists.
# Leave a line blank to keep the default. Do not commit service/.env.

# Optional. Without a key, Perform uses the stub planner (no model call).
# XAI_API_KEY=
# NC_LLM_MODEL=grok-4.3

# Optional. PEM from: openssl genpkey -algorithm ED25519 -out nc-signing-private.pem
# Or one line: base64:<32 raw seed bytes, standard base64>
# NC_SIGNING_KEY=

# Optional bot check. Leave unset to turn the gate off.
# TURNSTILE_SITEKEY=
# TURNSTILE_SECRET_KEY=

# Optional. Unset means /admin answers 404.
# NC_ADMIN_TOKEN=

# Optional. Header X-NC-Tester with this value skips the per-network
# 10-minute and daily limits on /api/perform and /api/gather.
# Generate with: openssl rand -hex 32
# Leave empty and every request stays on the public limits.
# NC_TESTER_TOKEN=

# Off. Set to 1 to open POST /api/perform-processed, the earlier layered
# engine (reverb, room tone, mastering). Gather and Perform stay raw assembly.
# NC_PROCESSED=

# Where the pages say this Performance lives.
NC_PUBLIC_BASE_URL=http://localhost:8080
NC_INSTANCE_NAME=nc-perform (self-hosted)

# File storage is the default. To use S3 or R2 instead:
# NC_STORAGE=s3://nc-performances
# NC_S3_ENDPOINT=https://ACCOUNT.r2.cloudflarestorage.com
# NC_S3_ACCESS_KEY_ID=
# NC_S3_SECRET_ACCESS_KEY=
# NC_S3_REGION=auto
